{
  "ApplicationSettings": {
    "ApplicationName": "Abm.PD.Console"
  },
  "Time": {
    "ServiceDefaultTimeZone": "10:00"
  },
  "FhirBulkExporter" : {
    "StreamedExportHttpClientTimeout" : "2:00"
  },
  "FhirBatchLoader": {
    "BatchSize": 200,
    "MaxRetainedFailures": 10
  },
  "FhirDiskWriter": {
    "OutputDirectoryPath": "C:\\Temp\\secrets"
  },
  "FhirNavigator": {
    "UserAgentName": "Abm.PD.Console",
    "UserAgentVersion": "1.0",
    "FhirRepositories": [
      {
        "Code": "[SeeUserSecrets]",
        "DisplayName": "[See User Secrets]",
        "ServiceBaseUrl": "https://no-where-of-intrest.com"
      }
    ]
  },
  "ProviderDirectory" : {
    "FhirRepositoryCodeAssignment" :
    {
      "HealthConnectProviderDirectorySource" : "[A Code from the FhirNavigator.FhirRepositories list]",
      "HealthLinkProviderDirectorySource" : "[A Code from the FhirNavigator.FhirRepositories list]",
      "TelstraHealthProviderDirectoryTarget" : "[A Code from the FhirNavigator.FhirRepositories list]"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Debug",
        "System": "Error",
        "System.Net.Http.HttpClient" : "Error",
        "Microsoft.Extensions.Http" :  "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "application.log",
          "rollingInterval": "Day"
        }
      }
    ]
  }
}