{
  "Time": {
    "ServiceDefaultTimeZone": "10:00"
  },
  "Database": {
    "RunMigrationsOnStartup": false
  },
  "ConnectionStrings": {
    "ProviderDirectoryDb": ""
  },
  "FhirBatchLoader": {
    "BatchSize": 200,
    "MaxRetainedFailures": 10
  },
  "FhirDiskWriter": {
    "OutputDirectoryPath": "C:\\Temp\\secrets"
  },
  "FhirNavigator": {
    "UserAgentName": "Abm.PD.Console",
    "UserAgentVersion": "1.0",
    "FhirRepositories": [
      {
        "Code": "[SeeUserSecrets]",
        "DisplayName": "[See User Secrets]",
        "ServiceBaseUrl": "https://no-where-of-intrest.com"
      }
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "application.log",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
